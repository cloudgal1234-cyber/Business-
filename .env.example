# מפתח Claude API (אופציונלי). בלי מפתח — האפליקציה עובדת במצב דמו עם מנוע מקומי.
ANTHROPIC_API_KEY=

# אופציונלי: דריסת מודל ורמת מאמץ (low | medium | high)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=

# אופציונלי: fallback לשליפת אתרים חוסמים דרך שירות קריאה חיצוני (r.jina.ai).
# ברירת מחדל: false — שום כתובת לא נשלחת לשירות צד שלישי בלי הסכמה מפורשת.
# READER_FALLBACK=true
